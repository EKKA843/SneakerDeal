# Copy this file to .env and fill in your real MongoDB Atlas connection string.
# Atlas Free Tier (M0) setup:
#   1. https://www.mongodb.com/cloud/atlas/register -> create a free M0 cluster
#   2. Database Access -> add a user + password
#   3. Network Access -> allow your IP (or 0.0.0.0/0 for local dev)
#   4. Connect -> "Drivers" -> copy the connection string below
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/sneakerdeal?retryWrites=true&w=majority

PORT=4000

# Required to use the admin panel (/admin.html and /api/admin/...). Pick any
# long random string — this is the shared secret sent as the "x-admin-token"
# header when adding products or editing offer prices/stock.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Cron schedule for auto-refreshing price/stock on offers that have a
# "sourceUrl" set (e.g. a SASOM product page). Default if unset: every 30
# minutes. Offers without a sourceUrl are never touched by this job.
PRICE_REFRESH_CRON=*/30 * * * *

# AccessTrade Publisher API — lets the admin panel generate real affiliate
# links (atth.me/go/...) instead of creating them by hand on the AccessTrade
# dashboard. Get USER_UID/SECRET_KEY by running
# src/scripts/getAccessTradeCredentials.js once (see its header comment),
# then find SITE_ID/CAMPAIGN_ID with src/scripts/listAccessTradeSites.js.
ACCESSTRADE_USER_UID=
ACCESSTRADE_SECRET_KEY=
ACCESSTRADE_SITE_ID=
ACCESSTRADE_CAMPAIGN_ID=
